          "type": "string"
        },
        "FlowSlowDown": {
          "additionalProperties": false,
          "properties": {
            "protocol_version": {
              "const": "v1",
              "default": "v1",
              "title": "Protocol Version",
              "type": "string"
            },
            "reason": {
              "enum": [
                "busy",
                "live_session_active",
                "resource_limit"
