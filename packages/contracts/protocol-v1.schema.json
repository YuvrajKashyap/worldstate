            "request_id": {
              "title": "Request Id",
              "type": "string"
            },
            "retry_after_ms": {
              "maximum": 10000,
              "minimum": 1,
              "title": "Retry After Ms",
              "type": "integer"
            },
            "type": {
              "const": "flow.slow_down",
              "default": "flow.slow_down",
