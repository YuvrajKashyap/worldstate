              "title": "Events",
              "type": "array"
            },
            "protocol_version": {
              "const": "v1",
              "default": "v1",
              "title": "Protocol Version",
              "type": "string"
            },
            "request_id": {
              "title": "Request Id",
              "type": "string"
            },
            "scene_id": {
              "maxLength": 36,
              "minLength": 36,
              "title": "Scene Id",
              "type": "string"
            },
            "sequence": {
              "minimum": 0,
              "title": "Sequence",
              "type": "integer"
            },
            "type": {
              "const": "event.batch",
              "default": "event.batch",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "request_id",
            "scene_id",
            "sequence",
            "events"
