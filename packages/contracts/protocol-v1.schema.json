          "additionalProperties": false,
          "properties": {
            "capture_to_result_ms": {
              "minimum": 0,
              "title": "Capture To Result Ms",
              "type": "number"
            },
            "depth_ran": {
              "title": "Depth Ran",
              "type": "boolean"
            },
            "discovery_ran": {
              "title": "Discovery Ran",
              "type": "boolean"
            },
            "dropped_frames": {
              "minimum": 0,
              "title": "Dropped Frames",
              "type": "integer"
            },
            "embedding_ran": {
              "title": "Embedding Ran",
              "type": "boolean"
            },
            "gpu_allocated_bytes": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Gpu Allocated Bytes"
            },
            "gpu_reserved_bytes": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
