              "title": "Idempotency Key",
              "type": "string"
            },
            "protocol_version": {
              "const": "v1",
              "default": "v1",
              "title": "Protocol Version",
              "type": "string"
            },
            "request_id": {
              "title": "Request Id",
              "type": "string"
            },
            "result": {
              "additionalProperties": true,
              "title": "Result",
              "type": "object"
            },
            "status": {
              "enum": [
                "accepted",
                "completed",
                "rejected"
              ],
              "title": "Status",
              "type": "string"
            },
            "type": {
              "const": "command.result",
              "default": "command.result",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "request_id",
            "idempotency_key",
            "status"
