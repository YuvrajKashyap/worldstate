            "box_xyxy": {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "title": "Box Xyxy",
              "type": "array"
            },
            "confidence": {
              "maximum": 1.0,
              "minimum": 0.0,
