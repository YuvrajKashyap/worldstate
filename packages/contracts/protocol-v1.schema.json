                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Position M"
            },
            "presence": {
              "$ref": "#/$defs/Presence"
