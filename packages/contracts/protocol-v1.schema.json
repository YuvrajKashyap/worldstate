            "sequence": {
              "minimum": 0,
              "title": "Sequence",
              "type": "integer"
            }
          },
          "required": [
            "sequence",
            "capture_to_result_ms",
            "inference_ms",
            "queue_depth",
            "dropped_frames",
            "discovery_ran",
            "depth_ran",
            "embedding_ran"
          ],
          "title": "FrameMetrics",
          "type": "object"
        },
        "FrameObject": {
          "additionalProperties": false,
          "properties": {
            "bounds_m": {
              "anyOf": [
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
