{
  "$defs": {
    "binaryFrameEnvelope": {
      "additionalProperties": false,
      "description": "Documented representation of the fixed-width binary frame header.",
      "properties": {
        "captured_at_unix_seconds": {
          "minimum": 0,
          "title": "Captured At Unix Seconds",
          "type": "number"
        },
        "encoding": {
          "enum": [
            "jpeg",
            "webp",
            "rgba",
            "i420"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "height": {
          "maximum": 4320,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "magic": {
          "const": "WSF1",
          "default": "WSF1",
          "title": "Magic",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "width": {
          "maximum": 7680,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "captured_at_unix_seconds",
        "width",
        "height",
        "encoding"
      ],
      "title": "FrameEnvelopeMetadata",
      "type": "object"
    },
    "clientMessage": {
      "$defs": {
        "ClientHello": {
          "additionalProperties": false,
          "properties": {
            "prompts": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Prompts",
              "type": "array"
            },
            "protocol_version": {
              "const": "v1",
              "title": "Protocol Version",
              "type": "string"
            },
            "request_id": {
              "maxLength": 120,
              "minLength": 1,
              "title": "Request Id",
              "type": "string"
            },
            "requested_capabilities": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Requested Capabilities",
              "type": "array"
            },
            "session_id": {
              "maxLength": 36,
              "minLength": 36,
              "title": "Session Id",
              "type": "string"
            },
            "type": {
              "const": "client.hello",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "protocol_version",
            "request_id",
            "session_id"
          ],
          "title": "ClientHello",
          "type": "object"
        },
        "CommandName": {
          "enum": [
            "select_entity",
            "pin_entity",
            "set_entity_visibility",
            "set_timeline_time",
            "query_entity",
            "find_last_seen",
            "start_scan",
            "cancel_job"
          ],
          "title": "CommandName",
          "type": "string"
        },
        "CommandSubmit": {
          "additionalProperties": false,
          "properties": {
            "arguments": {
              "additionalProperties": true,
              "title": "Arguments",
              "type": "object"
            },
            "command": {
              "$ref": "#/$defs/CommandName"
            },
            "entity_id": {
              "anyOf": [
                {
                  "maxLength": 36,
                  "minLength": 36,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Entity Id"
            },
            "expected_entity_state_id": {
              "anyOf": [
                {
                  "maxLength": 36,
                  "minLength": 36,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expected Entity State Id"
            },
            "idempotency_key": {
              "maxLength": 120,
              "minLength": 16,
              "title": "Idempotency Key",
              "type": "string"
            },
            "protocol_version": {
              "const": "v1",
              "title": "Protocol Version",
              "type": "string"
            },
            "request_id": {
              "maxLength": 120,
              "minLength": 1,
              "title": "Request Id",
              "type": "string"
            },
            "scene_id": {
              "maxLength": 36,
              "minLength": 36,
              "title": "Scene Id",
              "type": "string"
            },
            "type": {
              "const": "command.submit",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "protocol_version",
            "request_id",
            "idempotency_key",
            "command",
            "scene_id"
          ],
          "title": "CommandSubmit",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "client.hello": "#/$defs/ClientHello",
          "command.submit": "#/$defs/CommandSubmit"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ClientHello"
        },
        {
          "$ref": "#/$defs/CommandSubmit"
        }
      ]
    },
    "serverMessage": {
